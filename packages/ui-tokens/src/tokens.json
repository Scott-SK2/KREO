{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "KREO",
    "slogan": "Une idée, des talents, un projet.",
    "support": "Trouve ton équipe. Fais ton projet. Garde ton crédit."
  },
  "color": {
    "taupe": { "value": "#8B7262", "description": "Couleur principale" },
    "taupe-dark": { "value": "#5F4C40", "description": "Taupe foncé : états hover/actif" },
    "brown": { "value": "#3A2E27", "description": "Brun profond : texte fort" },
    "ivory": { "value": "#F2EBE1", "description": "Ivoire : surfaces secondaires" },
    "paper": { "value": "#FAF7F2", "description": "Papier : fond de page" },
    "ink": { "value": "#16110E", "description": "Encre : texte, fond sombre, icône d'app" },
    "gold": { "value": "#C6A15B", "description": "Or champagne : accents, crédits confirmés" },
    "bordeaux": { "value": "#7B2D3B", "description": "Bordeaux : alertes et favoris" },
    "white": { "value": "#FFFFFF" },
    "success": { "value": "#3F6B4E", "description": "Confirmation (contraste AA sur papier)" },
    "warning": { "value": "#8A5A14" },
    "danger": { "value": "#7B2D3B" },
    "focus": { "value": "#C6A15B" }
  },
  "font": {
    "display": {
      "value": "\"Playfair Display\", Georgia, serif",
      "weight": 900,
      "transform": "uppercase",
      "description": "Titres : Playfair Display 900, capitales"
    },
    "body": {
      "value": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "description": "Texte courant : DM Sans"
    }
  },
  "fontSize": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem",
    "xl": "1.25rem",
    "2xl": "1.5rem",
    "3xl": "1.875rem",
    "4xl": "2.25rem",
    "5xl": "3rem",
    "6xl": "3.75rem"
  },
  "lineHeight": { "tight": 1.1, "snug": 1.25, "normal": 1.5, "relaxed": 1.65 },
  "letterSpacing": { "display": "0.02em", "caps": "0.08em" },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.5rem",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(22, 17, 14, 0.06)",
    "md": "0 4px 12px rgba(22, 17, 14, 0.08)",
    "lg": "0 12px 32px rgba(22, 17, 14, 0.12)"
  },
  "touchTarget": { "min": "44px", "description": "WCAG 2.2 AA : cibles tactiles ≥ 44 px" },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "pattern": {
    "rings": {
      "description": "Cercles concentriques fins (ondes) pour couvertures, héros et visuels Instagram.",
      "stroke": "1px",
      "gap": "24px",
      "color": "#8B7262",
      "opacity": 0.18
    }
  },
  "icons": { "style": "stroke", "strokeWidth": 1.5, "library": "lucide", "emoji": "never" }
}

{
  "name": "@kreo/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Client TypeScript généré depuis le contrat OpenAPI de l'API KREO (web + mobile).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.d.ts --alphabetize",
    "lint": "echo 'api-client: schéma généré, rien à linter'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test src/problem.test.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}

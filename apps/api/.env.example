# Copier en .env — aucune valeur réelle ne doit être committée.
DJANGO_SETTINGS_MODULE=kreo.settings.dev
SECRET_KEY=change-me-in-local-only
DEBUG=true
DATABASE_URL=postgres://kreo:kreo@localhost:5432/kreo
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000
API_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=KREO <bonjour@kreo.local>
EMAIL_URL=smtp://localhost:1025
SENTRY_DSN=
# Médias (Cloudflare R2, compatible S3) — vides en local : stockage disque
MEDIA_BUCKET=
MEDIA_ENDPOINT_URL=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
# Feature flags par phase
FEATURE_SOCIAL=false
FEATURE_PUSH=false
FEATURE_SAVED_SEARCHES=false
FEATURE_APPEALS=false
